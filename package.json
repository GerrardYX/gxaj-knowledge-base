{
  "name": "gxaj-knowledge-base",
  "version": "1.0.0",
  "description": "gxaj知识库 - 基于MiniMax风格的智能问答系统",
  "main": "main.js",
  "scripts": {
    "start": "node proxy.js",
    "dev": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac --x64 --arm64",
    "build:dir": "electron-builder --win --dir",
    "pack:kb": "node scripts/pack-kb.js",
    "pack:kb:mac": "node scripts/pack-kb.js --mac"
  },
  "build": {
    "appId": "com.gxaj.knowledgebase",
    "productName": "gxaj知识库",
    "copyright": "Copyright © 2026 gxaj",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "proxy.js",
      "assets/**/*",
      "js/**/*",
      "css/**/*",
      "build/**/*",
      "vendor/**/*",
      "!vendor/models/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/models",
        "to": "vendor/models",
        "filter": ["**/*", "!*.part_*"]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "proxy.js",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "gxaj知识库",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "license": null
    },
    "publish": null
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.1",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "node-llama-cpp": "^3.18.1",
    "express": "^4.18.2",
    "jszip": "^3.10.1",
    "xmldom": "^0.6.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  }
}
